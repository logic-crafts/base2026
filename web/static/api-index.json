{
  "name": "Base2026 public developer surface",
  "version": "2026-09-01",
  "status": "public_read_only_v1",
  "base_url": "https://base2026.dev/",
  "policy": {
    "access": "public_read_only",
    "authentication": "none",
    "writes": false,
    "private_data": false,
    "raw_captions": false,
    "raw_asr": false,
    "media_files": false,
    "credentials": false,
    "rate_quota": "not_promised"
  },
  "entry_points": [
    {
      "id": "human_search_workspace",
      "url": "https://base2026.dev/workspace/",
      "format": "html",
      "description": "Public search workspace for human review of source records, topics and creators."
    },
    {
      "id": "api_access_page",
      "url": "https://base2026.dev/api",
      "format": "html",
      "description": "Free API guide with live search, static data, limits and privacy boundary."
    },
    {
      "id": "public_dataset_page",
      "url": "https://base2026.dev/dataset",
      "format": "html",
      "description": "Public dataset landing page with static distributions, live dimensions and source boundaries."
    },
    {
      "id": "source_index",
      "url": "https://base2026.dev/sources/",
      "format": "html",
      "description": "Public source catalog with attribution and bounded navigation."
    },
    {
      "id": "apply_research_page",
      "url": "https://base2026.dev/apply-research",
      "format": "html",
      "description": "Public research-boundary guidance for proposing an independent evidence question."
    },
    {
      "id": "mcp_page",
      "url": "https://base2026.dev/mcp",
      "format": "html",
      "description": "MCP transport, tool schemas, JSON examples and bounded-use guidance."
    },
    {
      "id": "integrations_page",
      "url": "https://base2026.dev/integrations",
      "format": "html",
      "description": "Truthful Codex and Claude Code setup for the public remote HTTP MCP endpoint."
    },
    {
      "id": "llms_context",
      "url": "https://base2026.dev/llms.txt",
      "format": "text",
      "description": "Concise machine-readable context, links and public boundary."
    },
    {
      "id": "data_dictionary",
      "url": "https://base2026.dev/data-dictionary.json",
      "format": "json",
      "description": "Public field, dataset and MCP response dictionary."
    }
  ],
  "endpoints": [
    {
      "id": "health",
      "url": "https://base2026.dev/api/health",
      "method": "GET",
      "format": "json",
      "description": "Read-only Worker and public D1 health response."
    },
    {
      "id": "stats",
      "url": "https://base2026.dev/api/stats",
      "method": "GET",
      "format": "json",
      "description": "Current public corpus, evidence-route, card and full-transcript privacy totals."
    },
    {
      "id": "evidence_brief_v1",
      "url": "https://base2026.dev/api/evidence-brief?q={question}",
      "method": "GET",
      "format": "json",
      "description": "Stable deterministic Evidence Brief V1 over public D1."
    },
    {
      "id": "evidence_brief_v2",
      "url": "https://base2026.dev/api/evidence-brief/v2?q={question}",
      "method": "GET",
      "format": "json",
      "description": "Bounded attributable findings with corpus coverage, limits and source links."
    },
    {
      "id": "multi_search",
      "url": "https://base2026.dev/api/search/multi-search",
      "method": "POST",
      "format": "json",
      "content_type": "application/json",
      "description": "Meilisearch-compatible read-only search over public evidence and the separately bound public Outreach index.",
      "index_uids": [
        "base2026_public_tiktok",
        "base2026_public_outreach"
      ]
    },
    {
      "id": "editorial_index",
      "url": "https://base2026.dev/api/blog",
      "method": "GET",
      "format": "json",
      "description": "Original editorial metadata with bounded pagination; counts remain separate from evidence and maintained guides."
    },
    {
      "id": "maintained_guides",
      "url": "https://base2026.dev/api/guides",
      "method": "GET",
      "format": "json",
      "description": "Published task guides on registered topic canonicals with bounded public evidence dependencies."
    },
    {
      "id": "mcp",
      "url": "https://base2026.dev/api/mcp",
      "method": "POST",
      "format": "json-rpc-2.0",
      "content_type": "application/json",
      "description": "Stateless public MCP endpoint over the evidence D1 projection.",
      "transport": "streamable_http_json",
      "sessions": false,
      "sse": false
    },
    {
      "id": "static_manifest",
      "url": "https://base2026.dev/static/manifest.json",
      "method": "GET",
      "format": "json",
      "description": "Dated static release dimensions and file metadata."
    },
    {
      "id": "static_documents",
      "url": "https://base2026.dev/static/documents.jsonl",
      "method": "GET",
      "format": "jsonl",
      "description": "Public source/search records for offline analysis."
    },
    {
      "id": "static_passages",
      "url": "https://base2026.dev/static/passages.jsonl",
      "method": "GET",
      "format": "jsonl",
      "description": "Bounded public evidence passages linked to source records."
    },
    {
      "id": "static_insight_cards",
      "url": "https://base2026.dev/static/insight_cards.jsonl",
      "method": "GET",
      "format": "jsonl",
      "description": "Reviewed source-backed public evidence cards."
    },
    {
      "id": "static_topic_signal_briefs",
      "url": "https://base2026.dev/static/topic_signal_briefs.jsonl",
      "method": "GET",
      "format": "jsonl",
      "description": "Deterministic topic signal briefs for strong public topics."
    }
  ],
  "mcp": {
    "endpoint": "https://base2026.dev/api/mcp",
    "human_docs": "https://base2026.dev/mcp",
    "protocol_versions": [
      "2026-07-28",
      "2025-11-25",
      "2025-06-18",
      "2025-03-26"
    ],
    "current_protocol": "2026-07-28",
    "discovery_method": "server/discover",
    "stateless": true,
    "json_only": true,
    "tools": [
      "search_sources",
      "get_source",
      "get_creator",
      "get_topic",
      "get_topic_signal",
      "get_public_manifest"
    ]
  },
  "route_templates": {
    "projected_source_page": "https://base2026.dev/sources/tiktok-video-{numeric_video_id}",
    "projection_condition": "only an applied public card with a numeric video ID"
  },
  "limits": {
    "worker_body_bytes": 65536,
    "multi_search_queries": 4,
    "multi_search_limit": 100,
    "multi_search_offset": 10000,
    "mcp_search_limit": 20,
    "mcp_search_offset": 1000,
    "mcp_source_passages": 8,
    "mcp_applied_cards": 3
  },
  "attribution": {
    "preserve_original_source_url": true,
    "preserve_base2026_source_page_when_returned": true,
    "coverage_claim": "bounded_public_corpus_only",
    "trend_claim": "not_realtime"
  },
  "not_offered": [
    "official marketplace plugin",
    "OAuth application",
    "private database access",
    "raw transcript or media access",
    "public writes or moderation"
  ],
  "project_identity": {
    "product": "Base2026",
    "owner": "Logic Crafts LLC, Kyrgyzstan",
    "status": "independent experimental startup product",
    "not_a_marketing_agency": true
  }
}
