{
  "name": "Base2026 public data dictionary",
  "version": "2026-09-01",
  "public_boundary": {
    "access": "public_read_only",
    "allowed": [
      "attributed public source records",
      "bounded public evidence passages",
      "public topic and creator metadata",
      "applied public insight cards",
      "dated static manifest dimensions"
    ],
    "not_public": [
      "raw captions",
      "raw ASR",
      "full private transcripts",
      "media files",
      "private review packets",
      "credentials",
      "logs",
      "inbox data",
      "local databases",
      "pipeline control state",
      "unreviewed source vaults"
    ]
  },
  "datasets": [
    {
      "id": "public_search_documents",
      "storage": "public D1 search_documents",
      "file": "/static/documents.jsonl",
      "format": "jsonl",
      "description": "Public search rows. One source can have multiple bounded passages.",
      "primary_fields": [
        "id",
        "item_id",
        "source_id",
        "chunk_id",
        "chunk_index",
        "body",
        "creator_display_name",
        "creator_handle",
        "creator_id",
        "creator_url",
        "full_transcript_public",
        "handle",
        "platform",
        "post_id",
        "public_policy",
        "public_surface",
        "published_at",
        "published_date",
        "source_type",
        "source_url",
        "title",
        "title_source",
        "title_status",
        "video_id",
        "year",
        "avatar_url",
        "topics",
        "topic_labels"
      ],
      "field_notes": {
        "body": "Public bounded passage used for search; not a raw transcript field.",
        "full_transcript_public": "Boolean projection flag; public search rows are false.",
        "topics": "Topic IDs represented as a JSON array in D1 and an array in API responses.",
        "topic_labels": "Human-readable topic labels represented as a JSON array in D1."
      }
    },
    {
      "id": "public_passages",
      "storage": "static export",
      "file": "/static/passages.jsonl",
      "format": "jsonl",
      "description": "Offline public passage records linked to source identity and attribution."
    },
    {
      "id": "public_insight_cards",
      "storage": "public D1 public_projection_cards plus static export",
      "file": "/static/insight_cards.jsonl",
      "format": "jsonl",
      "description": "Applied source-backed claim/action/topic cards with bounded evidence excerpts and timecodes.",
      "fields": [
        "source_id",
        "card_id",
        "ordinal",
        "claim_text",
        "suggested_action",
        "topic_label",
        "evidence_excerpt",
        "evidence_start_seconds",
        "evidence_end_seconds"
      ]
    },
    {
      "id": "topic_signal_briefs",
      "storage": "static export",
      "file": "/static/topic_signal_briefs.jsonl",
      "format": "jsonl",
      "description": "Deterministic summaries for topics that pass the public evidence gate.",
      "strong_topic_threshold": {
        "source_count": ">= 5",
        "creator_count": ">= 2",
        "public_insight_count": ">= 3"
      }
    }
  ],
  "api_contract": {
    "search_endpoint": "POST /api/search/multi-search",
    "search_index_uids": [
      "base2026_public_tiktok",
      "base2026_public_outreach"
    ],
    "default_shape": [
      "indexUid",
      "hits",
      "query",
      "processingTimeMs",
      "limit",
      "offset",
      "estimatedTotalHits"
    ],
    "search_limit": 100,
    "search_offset": 10000,
    "multi_search_queries": 4,
    "body_bytes": 65536
  },
  "mcp_contract": {
    "endpoint": "POST /api/mcp",
    "current_protocol": "2026-07-28",
    "supported_protocols": [
      "2026-07-28",
      "2025-11-25",
      "2025-06-18",
      "2025-03-26"
    ],
    "tools": {
      "search_sources": {
        "arguments": [
          "query",
          "creator_handle",
          "topic_id",
          "platform",
          "limit",
          "offset"
        ],
        "max_results": 20,
        "max_offset": 1000
      },
      "get_source": {
        "arguments": ["source_id"],
        "max_passages": 8,
        "max_applied_cards": 3
      },
      "get_creator": {
        "arguments": ["handle"],
        "max_source_samples": 10,
        "max_topics": 30
      },
      "get_topic": {
        "arguments": ["topic_id"],
        "max_source_samples": 10,
        "max_creator_samples": 10
      },
      "get_topic_signal": {
        "arguments": ["topic_id"],
        "method": "deterministic_public_d1_counts"
      },
      "get_public_manifest": {
        "arguments": [],
        "returns": "live public D1 dimensions and endpoint links"
      }
    }
  },
  "attribution": {
    "source_url": "original public source_url value from the source record",
    "source_page": "/sources/tiktok-video-{numeric_video_id} when an applied projection exists",
    "rule": "Preserve the original creator URL and identify Base2026 as a bounded public evidence layer."
  }
}
