{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "base2026",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "base2026.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../output/cloudflare-migration/base2026-enrichment-retirement-20260831-v2",
    "run_worker_first": [
      "/api/*",
      "/my-research",
      "/my-research/*",
      "/sources",
      "/sources/*",
      "/sitemap-dynamic.xml",
      "/sitemap-blog.xml",
      "/sitemap-guides.xml",
      "/sitemaps/blog-*",
      "/topics/*",
      "/blog",
      "/blog.html",
      "/blog/*",
      "/knowledge-search/*",
      "/search",
      "/search/*",
      "/search.html",
      "/meili.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "base2026-public-search",
      "database_id": "ac034130-4169-43c2-9a17-4b72d05457b0",
      "migrations_dir": "migrations"
    },
    {
      "binding": "INBOX_DB",
      "database_name": "base2026-inbox",
      "database_id": "542a77ef-da00-4522-8b7a-3d78fc646c72",
      "migrations_dir": "migrations-inbox"
    },
    {
      "binding": "OUTREACH_DB",
      "database_name": "base2026-outreach-search",
      "database_id": "ffbef187-67ef-491f-8fae-62f625636ed5",
      "migrations_dir": "migrations-outreach"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "base2026-member-auth",
      "database_id": "53b0adf1-39ac-40a7-93b8-84c08881ff43",
      "migrations_dir": "migrations-members"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "20260901",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "base2026_activation_v1"
    }
  ],
  "vars": {
    "MEMBER_AUTH_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
