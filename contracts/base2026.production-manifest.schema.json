{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base2026.dev/contracts/base2026.production-manifest.schema.json",
  "title": "Base2026 redacted production manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at",
    "status",
    "production_mutation_performed",
    "source",
    "workers",
    "routes",
    "bindings",
    "migrations",
    "live_checks",
    "unapplied_recommendations"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "base2026.production-manifest.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "observed_not_deployment_authorization"},
    "production_mutation_performed": {"const": false},
    "source": {"$ref": "#/$defs/source"},
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "redirect", "private"],
      "properties": {
        "public": {"$ref": "#/$defs/worker"},
        "redirect": {"$ref": "#/$defs/worker"},
        "private": {"$ref": "#/$defs/worker"}
      }
    },
    "routes": {"$ref": "#/$defs/routes"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "migrations": {"$ref": "#/$defs/migrations"},
    "live_checks": {"$ref": "#/$defs/live_checks"},
    "unapplied_recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseline_commit",
        "post_release_candidate_commit",
        "post_release_candidate_recorded_after_deploy",
        "deployed_artifact_tree_sha256",
        "release_config_sha256",
        "artifact_receipt_sha256",
        "source_state_at_release",
        "exact_commit_binding",
        "reproducible_from_commit"
      ],
      "properties": {
        "repository": {"type": "string", "pattern": "^github\\.com/"},
        "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "post_release_candidate_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "post_release_candidate_recorded_after_deploy": {"type": "boolean"},
        "deployed_artifact_tree_sha256": {"$ref": "#/$defs/sha256"},
        "release_config_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "source_state_at_release": {"enum": ["clean", "dirty_uncommitted_unpushed", "unknown"]},
        "exact_commit_binding": {"enum": ["resolved", "unresolved", "withheld"]},
        "reproducible_from_commit": {"type": "boolean"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_label", "version_id", "version_id_status", "traffic_percent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version_label": {"type": "string", "minLength": 1},
        "deployment_label": {"type": "string", "minLength": 1},
        "version_id": {"type": ["string", "null"], "pattern": "^[a-f0-9-]{36}$"},
        "version_id_status": {"enum": ["public", "withheld_private", "unresolved"]},
        "deployment_id": {"type": ["string", "null"], "pattern": "^[a-f0-9-]{36}$"},
        "traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custom_domains", "worker_first_patterns", "live_verified"],
      "properties": {
        "custom_domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "worker", "mode"],
            "properties": {
              "domain": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
              "worker": {"type": "string", "minLength": 1},
              "mode": {"const": "custom_domain"}
            }
          }
        },
        "worker_first_patterns": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"}
        },
        "live_verified": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_worker", "private_worker"],
      "properties": {
        "public_worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_runtime", "tracked_config", "missing_from_tracked_config", "vars", "secret_values_read_or_uploaded"],
          "properties": {
            "observed_runtime": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "tracked_config": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "missing_from_tracked_config": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "vars": {
              "type": "object",
              "additionalProperties": {"type": ["string", "boolean", "number", "null"]}
            },
            "secret_names_preserved": {"type": "boolean"},
            "secret_values_read_or_uploaded": {"const": false}
          }
        },
        "private_worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_runtime", "source_visibility", "identifiers_committed"],
          "properties": {
            "observed_runtime": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "source_visibility": {"const": "protected_not_in_public_repo"},
            "identifiers_committed": {"const": false}
          }
        }
      }
    },
    "migration_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "source_files", "runtime_status", "fresh_full_readback_required"],
      "properties": {
        "directory": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "source_files": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{4}_[A-Za-z0-9_-]+\\.sql$"}
        },
        "runtime_status": {"type": "string", "minLength": 1},
        "fresh_full_readback_required": {"const": true}
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_worker", "private_worker"],
      "properties": {
        "public_worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["DB", "INBOX_DB", "OUTREACH_DB", "AUTH_DB"],
          "properties": {
            "DB": {"$ref": "#/$defs/migration_binding"},
            "INBOX_DB": {"$ref": "#/$defs/migration_binding"},
            "OUTREACH_DB": {"$ref": "#/$defs/migration_binding"},
            "AUTH_DB": {"$ref": "#/$defs/migration_binding"}
          }
        },
        "private_worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied_count_observed", "pending_observed", "runtime_observation", "fresh_full_readback_required"],
          "properties": {
            "applied_count_observed": {"type": "integer", "minimum": 0},
            "pending_observed": {"type": "integer", "minimum": 0},
            "runtime_observation": {"type": "string", "minLength": 1},
            "fresh_full_readback_required": {"const": true}
          }
        }
      }
    },
    "live_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_health", "public_stats", "private_health", "route_status", "privacy_invariants"],
      "properties": {
        "public_health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "service", "search", "index"],
          "properties": {
            "ok": {"const": true},
            "service": {"const": "base2026"},
            "search": {"type": "string", "minLength": 1},
            "index": {"type": "string", "minLength": 1}
          }
        },
        "public_stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documents_indexed", "distinct_sources", "public_evidence_routes", "projected_cards", "full_transcripts_published"],
          "properties": {
            "documents_indexed": {"type": "integer", "minimum": 0},
            "distinct_sources": {"type": "integer", "minimum": 0},
            "public_evidence_routes": {"type": "integer", "minimum": 0},
            "projected_cards": {"type": "integer", "minimum": 0},
            "full_transcripts_published": {"const": 0}
          }
        },
        "private_health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http_status", "version_label", "deployment_label", "environment", "incident"],
          "properties": {
            "http_status": {"const": 200},
            "version_label": {"type": "string", "minLength": 1},
            "deployment_label": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "incident": {"type": "string", "minLength": 1}
          }
        },
        "route_status": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 100, "maximum": 599}
        },
        "privacy_invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full_transcripts_published", "signed_out_private_denied", "signed_out_api_denied"],
          "properties": {
            "full_transcripts_published": {"const": 0},
            "signed_out_private_denied": {"const": true},
            "signed_out_api_denied": {"const": true}
          }
        }
      }
    }
  }
}
