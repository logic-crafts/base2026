{
  "contract_version": 2,
  "release_lane": "public",
  "public_release": {
    "include_full_transcripts": false,
    "allow_package_include_full_transcripts_switch": false,
    "allow_deploy_include_full_transcripts_switch": false,
    "allow_reviewed_public_source_text": true,
    "allow_implicit_auto_promote_insights": false,
    "allowed_public_insight_review_statuses": [
      "approved",
      "reviewed",
      "public"
    ],
    "allowed_public_insight_promotion_methods": [
      "approved",
      "reviewed",
      "public"
    ],
    "minimum_public_insight_retention_ratio": 0.8
  },
  "public_manifest_contract": {
    "dataset_schema": "base2026.public-dataset-manifest/v1",
    "page_schema": "base2026.public-page-manifest/v1",
    "exact_key_allowlists": true,
    "reject_private_paths_recursively": true
  },
  "sitemap_contract": {
    "schema": "base2026.sitemap-admission/v2",
    "normal_public_card": "included_exactly",
    "provenance_archive_noindex": "excluded",
    "future_private_backlog": "excluded",
    "static_routes": "frozen_exact_allowlist",
    "require_http_200": true,
    "require_indexable": true,
    "require_exactly_one_self_canonical": true
  },
  "public_invocation_scripts": [
    "scripts/package-public-release.ps1",
    "scripts/deploy-public-vps.ps1",
    "scripts/hermes-tiktok-refresh.ps1"
  ],
  "generated_artifacts_not_committed": [
    "public-data/",
    "output/",
    ".planning/",
    "meili_data/"
  ],
  "required_public_gates": [
    "public_export_policy",
    "publication_boundary",
    "github_metadata",
    "mobile_visual_qa",
    "public_release_contract",
    "public_manifest_contract",
    "sitemap_admission_contract"
  ],
  "notes": [
    "Public releases publish attributed source records, reviewed public source text, source previews, topic pages, and explicitly reviewed public insight cards.",
    "Raw captions, raw ASR, media, private QA, and unreviewed transcripts remain private/local.",
    "The old full-transcript export flag remains blocked for public deploys; reviewed public source text is a separate public field.",
    "Implicit auto-promotion is disabled in the public release lane; promotion must be an explicit reviewed artifact."
  ]
}
