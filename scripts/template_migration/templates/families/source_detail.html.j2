{% extends "base_page.html.j2" %}
{% from "macros/platform_actions.html.j2" import platform_action %}
{% block content %}
<main id="content" class="b26-source-shell ayds-page ayds-main ayds-content" data-b26-shell data-b26-component="B26-04" data-b26-variant="source-detail" data-b26-visual="v2" data-admission-state="{{ view.admission_state }}" data-source-item-id="{{ view.item_id }}">
  <nav class="b26-arrival-nav ayds-breadcrumbs" aria-label="Breadcrumb and return navigation">
    <ol><li><a href="../">Base2026</a></li>{% if view.search_link %}<li><a href="{{ view.search_link }}">Search results</a></li>{% endif %}<li aria-current="page">{{ view.handle }}</li></ol>
    {% if view.search_link %}<a class="b26-back-link" href="{{ view.search_link }}" data-back-to-results>← Back to results</a>{% endif %}
  </nav>
  <header class="b26-source-intro ayds-hero">
    <div class="b26-creator-row">
      {% if view.creator_link %}<a class="b26-creator-avatar" href="{{ view.creator_link }}" aria-label="View {{ view.handle }} creator page">{% else %}<span class="b26-creator-avatar" aria-hidden="true">{% endif %}{% if view.avatar_src %}<img src="{{ view.avatar_src }}" alt="{{ view.avatar_alt }}" loading="eager" referrerpolicy="no-referrer">{% else %}<span aria-hidden="true">@</span>{% endif %}{% if view.creator_link %}</a>{% else %}</span>{% endif %}
      <div class="b26-creator-copy"><div><h1>{{ view.handle }}</h1><a href="{{ view.original_link }}" target="_blank" rel="noreferrer">{{ view.platform_label }}</a><time datetime="{{ view.date }}">{{ view.date }}</time></div><p>Attributed source record</p></div>
    </div>
    <p class="b26-source-thesis">{{ view.thesis }}</p>
    <div class="b26-source-actions ayds-actions">{% if view.search_link %}<a class="b26-action b26-action--primary ayds-btn ayds-btn--primary" href="{{ view.search_link }}">Open in Search</a>{% endif %}{{ platform_action(view.platform_key, view.original_link, "Open original", "Open original " ~ view.platform_label) }}{% if view.creator_link %}<a class="b26-action ayds-btn ayds-btn--secondary" href="{{ view.creator_link }}">View creator</a>{% endif %}<button class="b26-action ayds-btn ayds-btn--secondary" type="button" data-copy-source>Copy link</button><span aria-live="polite" data-copy-status></span></div>
    {% if view.archive %}<div class="b26-source-status" role="note" data-b26-component="B26-08" data-b26-variant="archive-boundary" data-b26-visual="v2"><strong>Provenance archive · noindex</strong><span>Retained for attribution. Editorial review did not approve a transferable public Source Intelligence card.</span></div>{% endif %}
  </header>
  <div class="b26-source-layout">
    <article class="b26-source-content">
      <section class="b26-source-section b26-source-text ayds-section" id="source-text"><div class="b26-section-heading"><p>Reviewed transcript</p><h2>Source Text</h2></div><div class="b26-reading-copy">{{ view.source_html | safe }}</div></section>
      {% if view.insights %}<section class="b26-source-section b26-source-intelligence ayds-section" id="intelligence"><div class="b26-section-heading"><p>Reviewed interpretation</p><h2>Source Intelligence</h2></div><div class="b26-intelligence-panel ayds-stack">{% for insight in view.insights %}<article class="b26-insight ayds-card ayds-card--data" data-insight-index="{{ loop.index0 }}"><span>What this source shows</span><h3>{{ insight.claim }}</h3><p class="b26-insight-meta">{{ insight.meta }}</p><div class="b26-insight-actions"><span>Recommended next steps</span><ul>{% for action in insight.actions %}<li>{{ action }}</li>{% endfor %}</ul></div><div class="b26-insight-topics" aria-label="Related topics">{% for topic in insight.topics %}<a class="ayds-chip" href="{{ topic.href }}">{{ topic.label }}</a>{% endfor %}</div></article>{% endfor %}</div></section>{% elif view.archive %}<section class="b26-source-section b26-archive-explanation ayds-section" id="intelligence"><div class="b26-section-heading"><p>Editorial state</p><h2>Why this record is archived</h2></div><p>The source remains available for provenance and attribution, but it is excluded from Search Workspace, creator listings, topic evidence pages, and normal public-card counts because no transferable public insight was approved.</p></section>{% endif %}
      {% if view.solutions %}<section class="b26-source-section b26-source-solution-bridge ayds-section" id="solutions" data-source-solution-count="{{ view.solutions | length }}"><div class="b26-section-heading b26-source-solution-bridge__heading"><p>Evidence → decision</p><h2>Decision playbooks using this source</h2></div><p class="b26-source-solution-bridge__boundary">Shown only where this exact reviewed source signal contributes to an approved Base2026 Solution. Creator claims remain separate from Base2026 synthesis.</p><div class="b26-source-solution-list ayds-stack">{% for solution in view.solutions %}<article class="b26-source-solution-card ayds-card ayds-card--feature" data-solution-id="{{ solution.solution_id }}"><span class="b26-source-solution-card__role">Evidence-bound Solution</span><h3><a href="{{ solution.href }}" data-journey-action="solution_opened" data-journey-surface="source_detail" data-solution-id="{{ solution.solution_id }}">{{ solution.title }}</a></h3><p>{{ solution.why_relevant }}</p></article>{% endfor %}</div></section>{% endif %}
      {% if view.questions %}<section class="b26-source-section b26-source-questions ayds-section" id="questions"><div class="b26-section-heading"><h2>Questions this source answers</h2></div><div class="b26-question-list">{% for question in view.questions %}<details class="b26-question ayds-disclosure"><summary>{{ question.question }}</summary><div><p>{{ question.answer }}</p></div></details>{% endfor %}</div></section>{% endif %}
      <section class="b26-source-provenance" id="provenance"{% if not view.archive %} data-b26-component="B26-08" data-b26-variant="source-provenance" data-b26-visual="v2"{% endif %}><p>Source provenance</p><div class="b26-provenance-actions">{{ platform_action(view.platform_key, view.original_link, "Open original " ~ view.platform_label, "Open original " ~ view.platform_label) }}<a class="b26-action" href="../source-policy.html">Source policy</a><a class="b26-action" href="../opt-out.html">Correction or removal</a></div></section>
    </article>
    <aside class="b26-source-rail ayds-card ayds-card--data" aria-label="Source details"><nav aria-label="On this page"><p>On this page</p><a href="#source-text">Source text</a>{% if view.insights or view.archive %}<a href="#intelligence">{% if view.archive %}Archive status{% else %}Intelligence{% endif %}</a>{% endif %}{% if view.solutions %}<a href="#solutions">Solutions</a>{% endif %}{% if view.questions %}<a href="#questions">Questions</a>{% endif %}<a href="#provenance">Provenance</a></nav><dl><div><dt>Platform</dt><dd>{{ view.platform_label }}</dd></div><div><dt>Language</dt><dd>{{ view.language }}</dd></div><div><dt>Policy</dt><dd>{{ view.policy }}</dd></div>{% if view.insight_count %}<div><dt>Reviewed insights</dt><dd>{{ view.insight_count }}</dd></div>{% endif %}{% if view.topics %}<div><dt>Topics</dt><dd class="b26-rail-topics">{% for topic in view.topics %}<a class="ayds-chip" href="{{ topic.href }}">{{ topic.label }}</a>{% endfor %}</dd></div>{% endif %}</dl></aside>
  </div>
  {{ view.schema_html | safe }}
</main>
{% endblock %}
